.PHONY: build clean test mod-download mod-tidy mod-verify

LDFLAGS := -s -w
BIN_DIR := bin
BINARY := alexandria

build:
	go build -ldflags="$(LDFLAGS)" -o $(BIN_DIR)/$(BINARY) .

clean:
	rm -rf $(BIN_DIR)

test:
	go test -v ./...

mod-download:
	go mod download

mod-tidy:
	go mod tidy

mod-verify:
	go mod verify
